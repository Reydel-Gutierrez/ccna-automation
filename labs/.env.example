# Copy this file to labs/.env and fill in values from DevNet Sandbox / dashboards.
# Never commit real credentials.

# Public HTTP lab (no key required)
HTTPBIN_BASE=https://httpbin.org

# Cisco DevNet IOS XE Always-On / reservable sandbox
IOSXE_HOST=devnetsandboxiosxe.cisco.com
IOSXE_SSH_PORT=22
IOSXE_NETCONF_PORT=830
IOSXE_RESTCONF_PORT=443
IOSXE_USER=
IOSXE_PASSWORD=

# Meraki Dashboard API
MERAKI_API_KEY=
MERAKI_BASE=https://api.meraki.com/api/v1

# Catalyst Center
CATALYST_CENTER_HOST=
CATALYST_CENTER_USER=
CATALYST_CENTER_PASSWORD=

# Webex
WEBEX_TOKEN=
WEBEX_BASE=https://webexapis.com/v1
